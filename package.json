{
    "name": "team-store",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "test": "vitest run --passWithNoTests",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint src",
        "lint:fix": "eslint src --fix",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.1",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
